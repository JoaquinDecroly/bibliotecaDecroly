				{
					"name": "Información de la biblioteca",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Código de estado 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Devuelve nombre, máximo de préstamos y días de préstamo\", function () {",
									"    const info = pm.response.json();",
									"    pm.expect(info.nombre).to.be.a(\"string\");",
									"    pm.expect(info.maxPrestamos).to.be.a(\"number\");",
									"    pm.expect(info.diasPrestamo).to.be.a(\"number\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/biblioteca/info",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"biblioteca",
								"info"
							]
						}
					},
					"response": []
				}
			]
		},
